# --- API (apps/api) ---
# Copy to apps/api/.env and adjust.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://photo:photo@localhost:5432/photo_tagging?schema=public
JWT_SECRET=change-me-to-a-long-random-string

# CORS: origin of the Next.js app
CORS_ORIGIN=http://localhost:3000

# Signed URLs for viewing blobs (seconds)
SIGNED_URL_TTL_SECONDS=3600

# Face matching thresholds (stricter defaults reduce false positives)
# MATCH_MIN_CERTAINTY=0.78
# MATCH_MIN_MARGIN=0.16
# MATCH_MIN_FACE_AREA=6400
# MATCH_MIN_DETECTION_SCORE=0.85
# MATCH_MIN_CERTAINTY_SINGLE_CANDIDATE=0.86

# Weaviate (matches docker-compose defaults)
WEAVIATE_URL=http://localhost:8081
# WEAVIATE_API_KEY=

# Backblaze B2 (S3-compatible). Omit and set USE_LOCAL_STORAGE=true for local-only blobs.
USE_LOCAL_STORAGE=true
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_ENDPOINT=
# B2_REGION=us-west-000

# Optional: seed / first admin (also used by prisma seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Admin

# --- Web (apps/web) ---
# NEXTAUTH_URL=http://localhost:3000
# AUTH_SECRET=generate-with-openssl-rand-base64-32
# API_URL=http://localhost:4000
# NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional OAuth (requires backend linkage — not enabled in default API):
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
